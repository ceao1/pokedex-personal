# URL de la base local que imprime `supabase status`
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
TCGDEX_BASE_URL=https://api.tcgdex.net/v2/en
SUPABASE_URL=http://127.0.0.1:54321
# `supabase status -o env` la imprime como SECRET_KEY
SUPABASE_SECRET_KEY=sb_secret_...
STORAGE_BUCKET=card-photos
# Base que recibe el NAVEGADOR para subir y descargar fotos. Vacía = igual
# que SUPABASE_URL. Obligatoria si abres la app desde el celular: para él,
# 127.0.0.1 es el propio celular y la foto nunca sube.
STORAGE_PUBLIC_URL=http://192.168.1.10:54321
# Llave de AI Studio para identificar cartas por foto. Sin ella, el endpoint
# de identificación responde 503 y el registro a mano sigue funcionando
# exactamente igual: esta variable es opcional, no un requisito de la app.
GEMINI_API=
GEMINI_MODEL=gemini-3.5-flash
